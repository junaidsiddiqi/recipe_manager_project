<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Recipes</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background: linear-gradient(135deg, #fbc2eb, #a6c1ee);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .container {
      background: rgba(255, 255, 255, 0.95);
      padding: 2rem;
      border-radius: 15px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.2);
      max-width: 900px;
    }
    .card {
      margin-bottom: 1rem;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1 class="mb-4">Recipes</h1>

    <!-- Recipe list -->
    <div class="row">
      <% recipes.forEach(function(recipe) { %>
        <div class="col-md-4">
          <div class="card">
            <div class="card-body text-center">
              <h5 class="card-title"><%= recipe.name %></h5>
              <p class="card-text"><%= recipe.instructions %></p>
              <a href="/cook/<%= recipe.id %>" class="btn btn-success">Cook</a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <!-- Add recipe form -->
    <form action="/recipes/add" method="post" class="mt-4 d-flex">
      <input type="text" name="name" class="form-control me-2" placeholder="Recipe name" required>
      <input type="text" name="instructions" class="form-control me-2" placeholder="Instructions" required>
      <button type="submit" class="btn btn-primary">Add Recipe</button>
    </form>

    <!-- Navigation -->
    <div class="mt-4">
      <a href="/" class="btn btn-secondary">Back to Home</a>
      <a href="/ingredients" class="btn btn-outline-info">View Ingredients</a>
    </div>
  </div>
</body>
</html>
