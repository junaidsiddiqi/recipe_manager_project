<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Recipe Manager</title>
  <!-- Bootstrap CSS only -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background: linear-gradient(135deg, #50e1da, #4c84bd);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .hero {
      background: rgba(255, 255, 255, 0.9);
      padding: 3rem;
      border-radius: 15px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.2);
      text-align: center;
      max-width: 600px;
    }
    .hero h1 {
      font-weight: 700;
      margin-bottom: 1rem;
    }
    .hero p {
      font-size: 1.2rem;
      margin-bottom: 2rem;
    }
  </style>
</head>
<body>

  <div class="hero">
    <h1 class="display-4">Recipe Manager</h1>
    <p class="lead">Organize your ingredients and cook up delicious recipes with ease.</p>

    <div class="d-flex justify-content-center gap-3">
      <a href="/ingredients" class="btn btn-primary btn-lg">View Ingredients</a>
      <a href="/recipes" class="btn btn-success btn-lg">View Recipes</a>
    </div>
  </div>

</body>
</html>
